# API Keys for Sketch AI - Backend Proxy
# Copy this file to .env.local and fill in your actual API keys

# Together AI - For FLUX.1-dev image generation
# Get key from: https://api.together.xyz/
TOGETHER_API_KEY=your_together_api_key_here

# Deep AI - For text-to-image generation
# Get key from: https://deepai.org/dashboard
DEEPAI_API_KEY=your_deepai_api_key_here

# Replicate - For FLUX.1-dev via Replicate
# Get token from: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=your_replicate_token_here

# Deployment URLs
# For local development: http://localhost:3000
# For Vercel: your-project.vercel.app
